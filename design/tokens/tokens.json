{
  "$description": "Feedants mobile app design tokens. Source of truth: src/index.css @theme block. Consumed by Tailwind CSS v4 as utility classes (bg-teal, text-ink, etc.).",
  "font": {
    "family": {
      "sans": "'Poppins', ui-sans-serif, system-ui, sans-serif"
    },
    "source": "Google Fonts — Poppins",
    "weights": [400, 500, 600, 700, 800],
    "import": "@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap');"
  },
  "color": {
    "teal":      { "value": "#0d8074", "role": "primary / brand, CTAs, active nav" },
    "teal-dark": { "value": "#0a6b60", "role": "primary pressed / gradients" },
    "ink":       { "value": "#1b2b3a", "role": "primary text / headings" },
    "slate":     { "value": "#6b7d8c", "role": "secondary text / captions" },
    "mint":      { "value": "#e8f5f1", "role": "tinted surfaces / badges" },
    "canvas":    { "value": "#f2f4f5", "role": "app background" },
    "white":     { "value": "#ffffff", "role": "cards / surfaces" }
  },
  "layout": {
    "app-max-width": "430px",
    "app-frame": "Centered mobile column, min-h-screen, canvas background"
  },
  "radius": {
    "note": "Tailwind defaults used throughout: rounded-xl (0.75rem) for buttons, rounded-2xl (1rem) for cards/tiles."
  },
  "motion": {
    "splash-pop": "0.6s cubic-bezier(0.22,1,0.36,1) both",
    "splash-rise": "0.6s ease-out both (delays 0.35s / 0.55s)",
    "splash-loader": "1.1s ease-in-out infinite"
  }
}
