{
  "name": "@feedants/payment",
  "version": "0.1.0",
  "private": true,
  "description": "Payment service: orders, signed webhooks, double-entry ledger, refunds, payouts, wallet",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && node ../../scripts/dev-service.mjs",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "prisma generate && jest",
    "db:migrate": "prisma migrate deploy",
    "db:migration": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script",
    "db:seed": "node dist/seed.js"
  },
  "dependencies": {
    "@feedants/seed-data": "workspace:*",
    "@feedants/server-kit": "workspace:*",
    "@feedants/shared": "workspace:*",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@feedants/testing": "workspace:*",
    "@nestjs/testing": "^11.2.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.2.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "typescript": "~5.9.3",
    "pg": "^8.23.0",
    "@types/pg": "^8.23.1"
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ]
}
