// Notification service data model — docs/02-design/ERD.md §5.
// A pure event consumer: it never publishes, so there is no outbox table.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum NotificationType {
  REGISTRATION_CONFIRMED
  PAYMENT_FAILED
  REFUND_ISSUED
  COMPETITION_PUBLISHED
  REGISTRATION_OPENED
  RESULTS_PUBLISHED
  PRIZE_WON
  COMPETITION_CANCELLED
}

model Notification {
  id        String           @id @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  /// Deep-link target (FR-NT-03), e.g. { "screen": "competition", "competitionId": "…" }.
  target    Json?
  /// The event that caused it: one notification per (event, user, type), however often redelivered.
  sourceEventId String       @map("source_event_id") @db.Uuid
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([sourceEventId, userId, type])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("notifications")
}

model InboxEvent {
  eventId      String   @map("event_id") @db.Uuid
  consumerName String   @map("consumer_name")
  processedAt  DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, consumerName])
  @@map("inbox_events")
}
