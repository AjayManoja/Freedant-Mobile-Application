# Identity service — copy to .env for `pnpm dev` (values match infra/docker/compose.yaml).
PORT=3001
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:8081
DATABASE_URL=postgresql://identity:identity_dev_password@localhost:5432/identity
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://feedants:feedants_dev_password@localhost:5672

# Leave JWT_PRIVATE_KEY empty in development to use a throwaway key per boot.
# Production: PKCS#8 PEM from SSM Parameter Store (see docs/03-development/LOCAL_SETUP.md).
JWT_PRIVATE_KEY=
JWT_KEY_ID=dev

OTP_PEPPER=change-me-local-dev-pepper-32chars

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Feedants <no-reply@feedants.local>

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=feedants-media
S3_ACCESS_KEY_ID=feedants
S3_SECRET_ACCESS_KEY=feedants_dev_password
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/feedants-media

# Optional: send traces to the local Jaeger (UI at http://localhost:16686).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
