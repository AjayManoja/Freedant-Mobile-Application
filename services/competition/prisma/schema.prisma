// Competition service data model — docs/02-design/ERD.md §3.
// Money is integer paise in int4 columns: every single amount is bounded by A-12
// (≤ ₹1,00,000 = 10,000,000 paise), well inside int4; aggregates are computed as bigint.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CompetitionStatus {
  DRAFT
  AWAITING_FUNDING
  PUBLISHED
  RESULTS_PUBLISHED
  CANCELLED
}

enum RegistrationStatus {
  HELD
  CONFIRMED
  EXPIRED
  REJECTED
  REFUNDED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
}

enum MediaKind {
  IMAGE
  AUDIO
  VIDEO
}

/// Reference data (A-20), loaded by the seed script — adding one needs no deploy.
model Category {
  id        Int    @id @default(autoincrement()) @db.SmallInt
  slug      String @unique
  name      String
  icon      String
  sortOrder Int    @default(0) @map("sort_order") @db.SmallInt

  competitions Competition[]

  @@map("categories")
}

/// Local copy of Identity's public profile fields, kept current from `user.updated`
/// (PROJECT_PLAN "local copies"), so lists and leaderboards never call Identity.
model UserProfile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String   @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_profiles")
}

model Competition {
  id          String            @id @db.Uuid
  hostId      String            @map("host_id") @db.Uuid
  status      CompetitionStatus @default(DRAFT)
  title       String?
  description String?
  categoryId  Int?              @map("category_id") @db.SmallInt
  coverKey    String?           @map("cover_key")
  coverUrl    String?           @map("cover_url")
  featured    Boolean           @default(false)

  prizePoolPaise   Int? @map("prize_pool_paise")
  entryFeePaise    Int? @map("entry_fee_paise")
  platformFeePaise Int? @map("platform_fee_paise")
  maxSpots         Int? @map("max_spots")
  spotsRemaining   Int  @default(0) @map("spots_remaining")
  confirmedCount   Int  @default(0) @map("confirmed_count")
  submissionCount  Int  @default(0) @map("submission_count")

  startAt                      DateTime? @map("start_at") @db.Timestamptz(3)
  durationDays                 Int?      @map("duration_days") @db.SmallInt
  registrationOpensAt          DateTime? @map("registration_opens_at") @db.Timestamptz(3)
  registrationClosesAt         DateTime? @map("registration_closes_at") @db.Timestamptz(3)
  submissionStartsAt           DateTime? @map("submission_starts_at") @db.Timestamptz(3)
  submissionEndsAt             DateTime? @map("submission_ends_at") @db.Timestamptz(3)
  resultsDueAt                 DateTime? @map("results_due_at") @db.Timestamptz(3)
  publishedAt                  DateTime? @map("published_at") @db.Timestamptz(3)
  resultsPublishedAt           DateTime? @map("results_published_at") @db.Timestamptz(3)
  cancelledAt                  DateTime? @map("cancelled_at") @db.Timestamptz(3)
  registrationOpenedNotifiedAt DateTime? @map("registration_opened_notified_at") @db.Timestamptz(3)

  fundingOrderId        String?   @map("funding_order_id") @db.Uuid
  fundingProviderOrder  String?   @map("funding_provider_order_id")
  fundingKeyId          String?   @map("funding_key_id")
  fundingIdempotencyKey String?   @map("funding_idempotency_key")
  fundingRequestedAt    DateTime? @map("funding_requested_at") @db.Timestamptz(3)
  fundingError          String?   @map("funding_error")

  /// Maintained by PostgreSQL (generated column, see the init migration); read only by search.
  searchDocument Unsupported("tsvector")? @map("search_document")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category      Category?            @relation(fields: [categoryId], references: [id])
  prizeTiers    PrizeTier[]
  registrations Registration[]
  submissions   Submission[]
  subscriptions NotifySubscription[]

  @@index([hostId, createdAt])
  @@map("competitions")
}

model PrizeTier {
  competitionId String @map("competition_id") @db.Uuid
  rank          Int    @db.SmallInt
  amountPaise   Int    @map("amount_paise")

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@id([competitionId, rank])
  @@map("prize_tiers")
}

model Registration {
  id                String             @id @db.Uuid
  competitionId     String             @map("competition_id") @db.Uuid
  creatorId         String             @map("creator_id") @db.Uuid
  status            RegistrationStatus
  idempotencyKey    String             @unique @map("idempotency_key")
  /// Entry fee + platform fee charged (0 for free competitions).
  amountPaise       Int                @map("amount_paise")
  paymentOrderId    String?            @map("payment_order_id") @db.Uuid
  providerOrderId   String?            @map("provider_order_id")
  paymentKeyId      String?            @map("payment_key_id")
  lastPaymentError  String?            @map("last_payment_error")
  holdExpiresAt     DateTime?          @map("hold_expires_at") @db.Timestamptz(3)
  confirmedAt       DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  competition Competition @relation(fields: [competitionId], references: [id])
  submission  Submission?

  @@index([competitionId, status])
  @@index([creatorId, createdAt])
  @@map("registrations")
}

model Submission {
  id               String           @id @db.Uuid
  registrationId   String           @unique @map("registration_id") @db.Uuid
  competitionId    String           @map("competition_id") @db.Uuid
  creatorId        String           @map("creator_id") @db.Uuid
  status           SubmissionStatus @default(DRAFT)
  mediaKey         String?          @map("media_key")
  mediaKind        MediaKind?       @map("media_kind")
  mediaContentType String?          @map("media_content_type")
  caption          String?
  rulesAccepted    Boolean          @default(false) @map("rules_accepted")
  /// Score in tenths (0–100) so "one decimal" is exact (FR-JG-02).
  scoreTenths      Int?             @map("score_tenths") @db.SmallInt
  scoreComment     String?          @map("score_comment")
  rank             Int?             @db.SmallInt
  prizePaise       Int              @default(0) @map("prize_paise")
  submittedAt      DateTime?        @map("submitted_at") @db.Timestamptz(3)
  scoredAt         DateTime?        @map("scored_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  registration Registration @relation(fields: [registrationId], references: [id])
  competition  Competition  @relation(fields: [competitionId], references: [id])

  @@index([competitionId, status])
  @@index([creatorId, updatedAt])
  @@map("submissions")
}

model NotifySubscription {
  competitionId String   @map("competition_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@id([competitionId, userId])
  @@map("notify_subscriptions")
}

model OutboxEvent {
  id            String    @id @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)

  @@map("outbox_events")
}

model InboxEvent {
  eventId      String   @map("event_id") @db.Uuid
  consumerName String   @map("consumer_name")
  processedAt  DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([eventId, consumerName])
  @@map("inbox_events")
}
