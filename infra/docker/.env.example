# Copy to infra/docker/.env. Local development values only — production secrets live in
# AWS SSM Parameter Store and never in a file (NFR-SC-05).
NODE_ENV=development
LOG_LEVEL=info

POSTGRES_PASSWORD=postgres_dev_password
IDENTITY_DB_PASSWORD=identity_dev_password
COMPETITION_DB_PASSWORD=competition_dev_password
PAYMENT_DB_PASSWORD=payment_dev_password
NOTIFICATION_DB_PASSWORD=notification_dev_password

RABBITMQ_USER=feedants
RABBITMQ_PASSWORD=feedants_dev_password

# Used by services running inside Compose (the `app` profile).
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://feedants:feedants_dev_password@rabbitmq:5672
JWKS_URL=http://identity:3001/.well-known/jwks.json
CORS_ORIGINS=http://localhost:8081

# Shared secret for service-to-service calls (Competition → Payment internal API), at least 16 characters.
INTERNAL_API_TOKEN=local-dev-internal-token-change-me

OTP_PEPPER=change-me-local-dev-pepper-32chars
SMTP_HOST=mailpit
SMTP_PORT=1025

S3_ENDPOINT=http://storage:9000
# What the phone uses to reach storage (your machine's LAN IP when testing on a device).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=feedants-media
S3_ACCESS_KEY_ID=feedants
S3_SECRET_ACCESS_KEY=feedants_dev_password
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/feedants-media

# Razorpay TEST MODE keys only (C-1). Get them from the Razorpay dashboard (test mode).
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
